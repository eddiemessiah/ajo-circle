# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public https URL where this server is reachable (Telegram buttons reject localhost)
PUBLIC_BASE_URL=https://your-tunnel.example.com
PORT=8787

# Celo mainnet RPC (forno is free; Chainstack if traffic outgrows it)
CELO_RPC_URL=https://forno.celo.org

# Attribution tag returned by Celo Builders registration (celo_ + 12 hex).
# Pay pages refuse to send any transaction until this is set.
ATTRIBUTION_TAG=

# Agent wallet: generated by `npm run wallet`. Never commit the real .env.
AGENT_PRIVATE_KEY=

# Filled in after `npm run register-agent -- --send`
ERC8004_AGENT_ID=
